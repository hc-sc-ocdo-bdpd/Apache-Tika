# Virtual environments
.venv/
venv/
env/
ENV/
*.virtualenv

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# Git files
.git/
.gitignore
.gitattributes

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.code-workspace
.vscode-test/

# OS files
.DS_Store
Thumbs.db
desktop.ini
*.bak

# Docker files (don't copy Docker-related files into the image)
Dockerfile
Dockerfile.*
docker-compose.yml
docker-compose.*.yml
.dockerignore

# Documentation (optional - uncomment if you don't want docs in container)
# README.md
# CHANGELOG.md
# LICENSE

# Test and coverage files
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
*.cover
.hypothesis/

# Logs
*.log
logs/
*.log.*

# Environment files
.env
.env.*
!.env.example

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Output files (they'll be generated in mounted volumes)
outputs/*.json
outputs/*.csv
outputs/*.md
outputs/*.txt

# Models (will be downloaded on first run or mounted)
models/*.ftz
models/*.bin

# Large test files (if you have any)
# test_files/*.large

# CI/CD files
.github/
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml

# Package manager files
.npm/
.yarn/
node_modules/

# Jupyter notebooks
.ipynb_checkpoints/
*.ipynb

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/